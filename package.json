{
  "name": "aegis-engine",
  "version": "0.7.0",
  "description": "Zero-build reactive UI engine — signals, islands, html templates, data layer, routing, forms, animations, offline. One ES module, no dependencies.",
  "type": "module",
  "main": "aegis.js",
  "types": "aegis.d.ts",
  "files": [
    "aegis.js",
    "aegis.min.js",
    "aegis.min.js.map",
    "aegis.core.js",
    "aegis.core.min.js",
    "aegis.d.ts",
    "aegis-devtools.js",
    "aegis-test.js",
    "aegis-test.d.ts",
    "build.mjs"
  ],
  "license": "MIT",
  "author": "Baurzhan Atinov <bauratynov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bauratynov/aegis.git"
  },
  "homepage": "https://aegisjs.com",
  "bugs": {
    "url": "https://github.com/bauratynov/aegis/issues"
  },
  "keywords": [
    "signals",
    "reactive",
    "ui",
    "framework",
    "zero-build",
    "web-components",
    "frontend",
    "no-dependencies",
    "custom-elements",
    "router",
    "forms",
    "offline-first",
    "islands",
    "no-build",
    "server-rendered",
    "hydration",
    "html-templates",
    "swr",
    "cache",
    "vanilla-js",
    "django",
    "rails",
    "laravel",
    "htmx-alternative"
  ],
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test test-core.mjs && node check-exports.mjs && tsc -p tsconfig.types.json && node test-prefetch-sim.mjs && node test-shake.mjs && node test-sched-sim.mjs",
    "test:prefetch": "node test-prefetch-sim.mjs",
    "test:shake": "node test-shake.mjs",
    "test:sched": "node test-sched-sim.mjs",
    "build": "node build.mjs",
    "test:browsers": "node test-browsers.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "module": "aegis.js",
  "exports": {
    ".": {
      "types": "./aegis.d.ts",
      "default": "./aegis.js"
    },
    "./min": {
      "types": "./aegis.d.ts",
      "default": "./aegis.min.js"
    },
    "./core": {
      "types": "./aegis.d.ts",
      "default": "./aegis.core.js"
    },
    "./devtools": {
      "default": "./aegis-devtools.js"
    },
    "./test": {
      "types": "./aegis-test.d.ts",
      "default": "./aegis-test.js"
    },
    "./core/min": {
      "types": "./aegis.d.ts",
      "default": "./aegis.core.min.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "aegis.min.js",
  "jsdelivr": "aegis.min.js"
}
