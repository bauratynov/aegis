{
  "name": "aegis-engine",
  "version": "0.7.0",
  "description": "Zero-build reactive UI engine — signals, islands, html templates, data layer, routing, forms, animations, offline. One ES module, no dependencies.",
  "type": "module",
  "main": "aegis.js",
  "types": "aegis.d.ts",
  "files": [
    "aegis.js",
    "aegis.min.js",
    "aegis.min.js.map",
    "aegis.core.js",
    "aegis.core.min.js",
    "aegis.d.ts",
    "build.mjs"
  ],
  "license": "MIT",
  "author": "atynov",
  "repository": {
    "type": "git",
    "url": "https://github.com/atynov/aegis.git"
  },
  "homepage": "https://github.com/atynov/aegis",
  "bugs": {
    "url": "https://github.com/atynov/aegis/issues"
  },
  "keywords": [
    "signals",
    "reactive",
    "ui",
    "framework",
    "zero-build",
    "web-components",
    "frontend",
    "no-dependencies",
    "custom-elements",
    "router",
    "forms",
    "offline-first"
  ],
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test test-core.mjs && node check-exports.mjs && tsc -p tsconfig.types.json",
    "build": "node build.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "module": "aegis.js",
  "exports": {
    ".": {
      "types": "./aegis.d.ts",
      "default": "./aegis.js"
    },
    "./min": {
      "types": "./aegis.d.ts",
      "default": "./aegis.min.js"
    },
    "./core": {
      "types": "./aegis.d.ts",
      "default": "./aegis.core.js"
    },
    "./core/min": {
      "types": "./aegis.d.ts",
      "default": "./aegis.core.min.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "aegis.min.js",
  "jsdelivr": "aegis.min.js"
}
